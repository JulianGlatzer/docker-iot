{
  "__inputs": [],
  "__requires": [],
  "title": "IoT \u2013 Latest values",
  "uid": "iot-latest",
  "schemaVersion": 38,
  "version": 5,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "tags": [
    "iot"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Electricity & Watermeter \u2013 latest values",
      "description": "One row per field. Red = last update older than 24 h.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-sensordata"
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Field",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "field": "Field",
              "value": "Value",
              "timestamp": "Last seen"
            },
            "excludeByName": {},
            "indexByName": {
              "field": 0,
              "value": 1,
              "timestamp": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "transparent",
                      "value": -86400000
                    }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "elec",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-sensordata"
          },
          "query": "from(bucket: \"sensordata\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"electricity\")\n  |> group(columns: [\"_field\"])\n  |> last()\n  |> map(fn: (r) => ({field: r._field, value: r._value, timestamp: r._time}))"
        },
        {
          "refId": "water",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-sensordata"
          },
          "query": "from(bucket: \"sensordata\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"watermeter\")\n  |> group(columns: [\"_field\"])\n  |> last()\n  |> map(fn: (r) => ({field: if r._field == \"value\" then \"Watermeter value\" else \"Watermeter rate\", value: r._value, timestamp: r._time}))"
        }
      ]
    },
    {
