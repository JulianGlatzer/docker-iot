    {
      "id": 5,
      "title": "Watermeter errors",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-sensordata"
      },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "errors",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-sensordata"
          },
          "query": "from(bucket: \"sensordata\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"watermeter_errors\" and r._field == \"message\" and r._value != \"no error\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    }
