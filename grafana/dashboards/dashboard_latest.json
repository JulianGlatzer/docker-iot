    {
      "id": 3,
      "title": "Room temperature \u2013 latest values",
      "description": "One row per device. Red = last update older than 24 h.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-sensordata"
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Device",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "device": "Device",
              "temperature": "Temperature",
              "timestamp": "Last seen"
            },
            "excludeByName": {},
            "indexByName": {
              "device": 0,
              "temperature": 1,
              "timestamp": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
