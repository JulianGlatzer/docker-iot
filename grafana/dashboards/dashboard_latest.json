            "type": "influxdb",
            "uid": "influxdb-sensordata"
          },
          "query": "from(bucket: \"sensordata\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"Temperature\")\n  |> group(columns: [\"device_name\"])\n  |> last()\n  |> map(fn: (r) => ({device: r.device_name, temperature: r._value, timestamp: r._time}))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Room humidity & pressure \u2013 latest values",
      "description": "One row per device, fields as columns. Red = last update older than 24 h.",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-sensordata"
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Device",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "device",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "device": "Device",
              "humidity": "Humidity",
              "dewpoint": "Dew point",
              "pressure": "Pressure",
              "timestamp": "Last seen"
            },
            "excludeByName": {},
            "indexByName": {
              "device": 0,
              "humidity": 1,
              "dewpoint": 2,
              "pressure": 3,
              "timestamp": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "transparent",
                      "value": -86400000
                    }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Humidity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dew point"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pressure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pressurembar"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "humid",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-sensordata"
          },
          "query": "from(bucket: \"sensordata\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and (r._field == \"Humidity\" or r._field == \"DewPoint\" or r._field == \"Pressure\"))\n  |> group(columns: [\"device_name\", \"_field\"])\n  |> last()\n  |> pivot(rowKey: [\"device_name\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({device: r.device_name, humidity: r.Humidity, dewpoint: r.DewPoint, pressure: r.Pressure}))"
        },
        {
          "refId": "ts",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-sensordata"
          },
          "query": "from(bucket: \"sensordata\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"temperature\" and r._field == \"Humidity\")\n  |> group(columns: [\"device_name\"])\n  |> last()\n  |> map(fn: (r) => ({device: r.device_name, timestamp: r._time}))"
        }
      ]
