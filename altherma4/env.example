# ---- Altherma 4 / MariaDB – copy these lines into the .env in the repository root ----

# MariaDB
MARIADB_ROOT_PASSWORD=change-me
ALTHERMA_DB_PASSWORD=change-me
# read-only user "grafana" for the Grafana data source (do not use quotes)
MARIADB_GRAFANA_PASSWORD=change-me

# InfluxDB: uses INFLUXDB_ADMIN_TOKEN from the .env (like telegraf and grafana)
ALTHERMA_INFLUXDB_BUCKET=sensordata

# Heat pump
# IP address of the indoor unit (required)
ALTHERMA_HOST=
ALTHERMA_PORT=502
ALTHERMA_UNIT_ID=1
POLL_INTERVAL=15

# Notifications: uses GF_TELEGRAM_BOT_TOKEN, GF_TELEGRAM_CHAT_ID, SMTP_HOST,
# SMTP_USER, SMTP_PASSWORD, SMTP_FROM_ADDRESS, GF_NOTIFICATION_EMAIL from the .env.
# SMTP_HOST may be "host:port" (Grafana format); 465 = SSL, otherwise STARTTLS.
ALTHERMA_SMTP_SECURITY=starttls
# dead man's switch, e.g. https://hc-ping.com/<uuid> (empty = off)
ALTHERMA_HEARTBEAT_URL=

# Alarm thresholds (0 = alarm off)
ALERT_PRESSURE_MIN=0.9
ALERT_PRESSURE_DROP=0.2
ALERT_BUH_MIN=10
ALERT_BUH_KWH_DAY=2
ALERT_STARTS_PER_HOUR=3
ALERT_LWT_DEV=5
ALERT_LWT_MIN=30
ALERT_FLOW_MIN=3
ALERT_DEFROST_MAX_MIN=15
ALERT_DEFROST_PER_HOUR=2
ALERT_DB_MIN=30

# Hydraulic separator (optional): w1:<id> | file:<path> | modbus://ip:502/unit/ir/address
SEC_SUPPLY_SOURCE=
SEC_RETURN_SOURCE=
SEC_SUPPLY_OFFSET=0
SEC_RETURN_OFFSET=0
ALERT_HYD_MIN=60

# Weekly report: 1 = Monday … 7 = Sunday, 0 = off
REPORT_WEEKDAY=1
REPORT_HOUR=7
